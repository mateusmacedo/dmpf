{
  "name": "dmpf-testkit-go",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/go/dmpf-testkit",
  "tags": ["type:lib", "scope:backend", "stack:go", "layer:providers"],
  "targets": {
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["dmpf-provider-postgres-go"],
          "target": "test-race"
        }
      ],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration ./...",
        "cwd": "{projectRoot}"
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-distributed": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["dmpf-provider-postgres-go", "dmpf-app-go"],
          "target": "test-race"
        }
      ],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration,distributed ./distkit/...",
        "cwd": "{projectRoot}"
      }
    },
    "evidence": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["dmpf-provider-postgres-go", "dmpf-app-go", "dmpf-reference-go"],
          "target": "test-race"
        }
      ],
      "options": {
        "command": "GOTOOLCHAIN=go1.26.6 go run ./libs/backend/go/dmpf-testkit/cmd/dmpf-evidence --root . --release latest",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
