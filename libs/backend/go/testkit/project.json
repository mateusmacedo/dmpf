{
  "name": "testkit",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/go/testkit",
  "tags": ["type:lib", "scope:backend", "stack:go", "layer:providers"],
  "targets": {
    "tidy": {
      "executor": "@mateusmacedo/dmpf-plugin:go-tidy",
      "cache": false
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "@mateusmacedo/dmpf-plugin:test-env",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        "test-infra-up",
        {
          "projects": ["postgres"],
          "target": "test-race"
        }
      ],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration ./..."
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-infra-up": {
      "executor": "@mateusmacedo/dmpf-plugin:test-infra",
      "cache": false,
      "options": {
        "action": "up"
      }
    },
    "test-infra-down": {
      "executor": "@mateusmacedo/dmpf-plugin:test-infra",
      "cache": false,
      "options": {
        "action": "down"
      }
    }
  }
}
