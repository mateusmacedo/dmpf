{
  "name": "contracts",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/go/contracts",
  "tags": ["type:lib", "scope:backend", "stack:go", "layer:contract"],
  "targets": {
    "tidy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash ../../../../tools/go-tidy.sh",
        "cwd": "{projectRoot}"
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go test -race ./...",
        "cwd": "{projectRoot}"
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "buf-warmup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash tools/buf-gate.sh warmup libs/backend/go/contracts --project contracts"
      }
    },
    "buf-lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["buf-warmup"],
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/**/*"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh lint libs/backend/go/contracts --project contracts"
      }
    },
    "buf-pins": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/go.mod"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh pins libs/backend/go/contracts --project contracts"
      }
    },
    "buf-generate-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["buf-warmup"],
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/gen/**/*",
        "{projectRoot}/go.mod"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh generate-check libs/backend/go/contracts --project contracts"
      }
    },
    "buf-breaking": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{workspaceRoot}/tools/buf.sh", "{workspaceRoot}/tools/buf-gate.sh"],
      "options": {
        "command": "bash tools/buf-gate.sh breaking libs/backend/go/contracts --project contracts"
      }
    },
    "buf-gate-selftest": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["buf-warmup"],
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{workspaceRoot}/tools/tests/buf-gate/**",
        "{projectRoot}/gen/**/*",
        "{projectRoot}/go.mod"
      ],
      "options": {
        "command": "bash tools/tests/buf-gate/buf-gate.test.sh"
      }
    }
  }
}
