# Exemplo de variáveis de ambiente. Copie para `.env` e ajuste os valores.
# O arquivo `.env` é ignorado pelo git; este `.env.example` é versionado.

# NODE_ENV=development

# O Nx carrega o `.env` da raiz em todo target: estas chaves apontam os testes de
# integração e as ferramentas que rodam no host para a infra local
# (`pnpm nx run bff:infra-up`). As variáveis de cada processo ficam em
# apps/backend/<app>/deploy/.env.example.

# Postgres: usuário que cria banco, porque cada projeto testa no seu
# `<projeto>_test`, derivado deste servidor (ADR-053)
PG_DSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Redpanda: listener externo publicado no host, sem SASL
KAFKA_BROKERS=localhost:9092

# floci (SQS e SNS)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Collector OTLP/gRPC da observabilidade local
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
