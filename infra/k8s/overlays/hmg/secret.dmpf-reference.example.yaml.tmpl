# Forma dos dois Secrets que o overlay hmg espera encontrar no namespace. Este
# arquivo não é resource do kustomization e os valores não conectam a nada:
# em homologação eles vêm de um ExternalSecret/SealedSecret com os mesmos nomes.
apiVersion: v1
kind: Secret
metadata:
  name: dmpf-reference
type: Opaque
stringData:
  DMPF_PG_DSN: postgres://REPLACE_ME:REPLACE_ME@postgres.hmg.internal:5432/dmpf?sslmode=require
  DMPF_KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
type: Opaque
stringData:
  password: REPLACE_ME
