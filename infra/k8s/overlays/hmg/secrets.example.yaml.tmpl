# Forma dos Secrets de plataforma que o overlay hmg espera encontrar no
# namespace; os de cada app ficam em apps/backend/<app>/deploy/k8s/overlays/hmg.
# Este arquivo não é resource do kustomization e os valores não conectam a nada:
# em homologação eles vêm de um ExternalSecret/SealedSecret com os mesmos nomes.
# Os bancos orders, reservations e bookings já existem no Postgres gerenciado,
# cada um pertencendo ao role de mesmo nome.
# Pré-requisito do Kafka gerenciado, fora deste repositório: autorização ligada
# e as ACLs por principal do ADR-052 gravadas antes da subida. Sem elas,
# qualquer principal autenticado publica em orders.events e o consumer admite
# o envelope forjado como fronteira verificada.
# CA que emitiu os certificados de cliente; é o que os `api` exigem do chamador.
apiVersion: v1
kind: Secret
metadata:
  name: grpc-client-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
# Certificado do receiver OTLP do Collector, emitido pela CA dos certificados de
# servidor dos `api` (a de bff-grpc-ca); o SAN precisa cobrir otel-collector.
apiVersion: v1
kind: Secret
metadata:
  name: otel-collector-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
# A CA que emitiu otel-collector-tls, montada pelos processos dos contextos.
apiVersion: v1
kind: Secret
metadata:
  name: otel-collector-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
type: Opaque
stringData:
  password: REPLACE_ME
