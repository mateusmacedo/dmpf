# Forma dos Secrets que o overlay hmg espera encontrar no namespace. Este
# arquivo não é resource do kustomization e os valores não conectam a nada:
# em homologação eles vêm de um ExternalSecret/SealedSecret com os mesmos nomes.
# Os bancos orders, reservations e bookings já existem no Postgres gerenciado,
# cada um pertencendo ao role de mesmo nome.
# Pré-requisito do Kafka gerenciado, fora deste repositório: autorização ligada
# e as ACLs por principal do ADR-052 gravadas antes da subida. Sem elas,
# qualquer principal autenticado publica em orders.events e o consumer admite
# o envelope forjado como fronteira verificada.
apiVersion: v1
kind: Secret
metadata:
  name: orders
type: Opaque
stringData:
  PG_DSN: postgres://orders:REPLACE_ME@postgres.hmg.internal:5432/orders?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em orders.events
  # e orders.events.dlq (ADR-052).
  KAFKA_SASL_USERNAME: orders
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: reservations
type: Opaque
stringData:
  PG_DSN: postgres://reservations:REPLACE_ME@postgres.hmg.internal:5432/reservations?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # reservations.events, reservations.events.dlq e orders.events.dlq; read e
  # describe em orders.events e no grupo reservations (ADR-052).
  KAFKA_SASL_USERNAME: reservations
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
# Certificado de servidor do api de orders; o SAN precisa cobrir o host do alvo
# que o BFF usa (orders-api).
apiVersion: v1
kind: Secret
metadata:
  name: orders-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: reservations-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
# CA que emitiu os dois certificados acima; é o que o BFF confia.
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
# Certificado de cliente do BFF, com a URI spiffe://dmpf/bff no SAN — é a
# identidade que os `api` confiam (GRPC_TRUSTED_CLIENTS).
apiVersion: v1
kind: Secret
metadata:
  name: bff-grpc-client
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
---
# CA que emitiu os certificados de cliente; é o que os `api` exigem do chamador.
apiVersion: v1
kind: Secret
metadata:
  name: grpc-client-ca
type: Opaque
stringData:
  ca.crt: REPLACE_ME
---
# Servidor de autorização que o BFF verifica (apps/backend/bff/README.md). O
# emissor, a audiência e a claim de tenant dependem do realm de homologação.
apiVersion: v1
kind: Secret
metadata:
  name: bff-oidc
type: Opaque
stringData:
  OIDC_ISSUER: REPLACE_ME
  OIDC_AUDIENCE: REPLACE_ME
  OIDC_TENANT_CLAIM: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
type: Opaque
stringData:
  password: REPLACE_ME
