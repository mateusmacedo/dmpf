          },
          "expr": "sum ((increase(k6_context_admission_rejections_total{testid=\"$testid\"}[$__rate_interval]) or k6_context_admission_rejections_total{testid=\"$testid\"} * 0) + ((k6_context_admission_rejections_total{testid=\"$testid\"} unless k6_context_admission_rejections_total{testid=\"$testid\"} offset $__rate_interval) or k6_context_admission_rejections_total{testid=\"$testid\"} * 0)) or on() vector(0)",
          "legendFormat": "recusas do contexto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum ((increase(k6_dropped_iterations_total{testid=\"$testid\"}[$__rate_interval]) or k6_dropped_iterations_total{testid=\"$testid\"} * 0) + ((k6_dropped_iterations_total{testid=\"$testid\"} unless k6_dropped_iterations_total{testid=\"$testid\"} offset $__rate_interval) or k6_dropped_iterations_total{testid=\"$testid\"} * 0)) or on() vector(0)",
          "legendFormat": "iterações descartadas",
          "refId": "B"
        }
      ],
