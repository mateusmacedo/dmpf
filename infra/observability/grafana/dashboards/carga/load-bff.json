    {
      "type": "bargauge",
      "title": "k6 ÷ borda por rota no intervalo",
      "description": "Requisições do k6 sobre as vistas na borda (otelhttp), por método e http.route, somadas no intervalo escolhido: 1 significa que a borda viu tudo o que o k6 enviou. A razão por taxa oscilava porque o k6 chega a cada 5 s e a borda a cada 60 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              },
              {
                "color": "red",
                "value": 1.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, name) (increase(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\"}[$__range])) / sum by (method, name) (label_replace(label_replace(increase(http_server_request_duration_seconds_count{service_name=\"bff\"}[$__range]), \"method\", \"$1\", \"http_request_method\", \"(.*)\"), \"name\", \"$1\", \"http_route\", \"(.*)\"))",
          "legendFormat": "{{method}} {{name}}",
          "refId": "A"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
