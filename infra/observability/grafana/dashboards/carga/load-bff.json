    {
      "type": "timeseries",
      "title": "Status não-OK por método e código (eventos na janela)",
      "description": "rpc.client.call.duration do otelgrpc com rpc.response.status_code diferente de OK, contando a série que nasce na janela (o primeiro DEADLINE_EXCEEDED cria a série). NOT_FOUND em FindReservation é o polling de convergência do k6, não falha.",
      "datasource": {
