{
  "uid": "load-bff",
  "title": "DMPF · Carga pela borda do BFF (k6)",
  "description": "Execução do k6 filtrada por testid, correlacionada com a borda do BFF (otelhttp e spans SERVER), as chamadas gRPC do BFF, o RED dos casos de uso e os recursos da topologia.",
  "tags": ["dmpf", "k6", "load", "carga"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Execução",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "query_result(sort_desc(max by (testid) (max_over_time(timestamp(k6_vus)[$__range:1m]))))",
        "regex": "/testid=\"([^\"]+)\"/",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
