          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"bff\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"HTTP .*\", span_name!~\"HTTP GET /(readyz|livez)\"}[$__rate_interval]))",
          "legendFormat": "borda",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "k6 ÷ borda por rota",
      "description": "Razão entre a taxa do k6 e a da borda por método e rota; 1 significa que a borda viu tudo o que o k6 enviou.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
