        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(k6_reservation_convergence_seconds{testid=\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 9,
      "title": "Borda do BFF (span-metrics do Tempo)",
