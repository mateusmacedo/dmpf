          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"bff\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"HTTP .*\", span_name!~\"HTTP GET /(readyz|livez)\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Latência por rota na borda (p95)",
