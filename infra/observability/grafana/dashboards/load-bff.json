{
  "uid": "load-bff",
  "title": "DMPF — carga pela borda do BFF (k6)",
  "description": "Execução do k6 filtrada por testid, correlacionada com a borda do BFF, as séries de serviço do kernel e os recursos da topologia.",
  "tags": ["dmpf", "k6", "load"],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Execução",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_http_reqs_total, testid)",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "k6 — execução",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "VUs",
      "description": "VUs ativas do k6 na execução selecionada.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus{testid=\"$testid\"})",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Requisições por jornada",
      "description": "Taxa de requisições do k6 por jornada.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (journey) (rate(k6_http_reqs_total{testid=\"$testid\"}[$__rate_interval]))",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Requisições por rota",
      "description": "Taxa de requisições do k6 por método e template de rota.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, name) (rate(k6_http_reqs_total{testid=\"$testid\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Latência por rota (p95, p99)",
      "description": "Percentis do histograma nativo do k6 por método e rota.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (method, name) (rate(k6_http_req_duration_seconds{testid=\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p95 {{method}} {{name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (method, name) (rate(k6_http_req_duration_seconds{testid=\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p99 {{method}} {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Falha técnica e recusa de admissão",
      "description": "Fração das requisições com 5xx ou erro de transporte e fração de 429.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\", status=~\"5..|0\"}[$__rate_interval])) / sum(rate(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "falha técnica",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\", status=\"429\"}[$__rate_interval])) / sum(rate(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "recusa 429",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Recusas do contexto e iterações descartadas",
      "description": "429 vindos do contexto (sem Retry-After) e iterações que o k6 não conseguiu iniciar por falta de VU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_context_admission_rejections_total{testid=\"$testid\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "recusa do contexto /s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_dropped_iterations_total{testid=\"$testid\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "iterações descartadas /s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Convergência da reserva (p95)",
      "description": "Do fim do place à primeira leitura 200 da reserva.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
