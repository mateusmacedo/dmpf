    {
      "type": "timeseries",
      "id": 10,
      "title": "Requisições por rota na borda",
      "description": "Spans de servidor HTTP do BFF, sem os endpoints de saúde.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
