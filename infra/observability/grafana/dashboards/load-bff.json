        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (label_replace(label_join(rate(k6_http_reqs_total{testid=\"$testid\", name!=\"/readyz\"}[$__rate_interval]), \"route\", \" \", \"method\", \"name\"), \"route\", \"HTTP $1\", \"route\", \"(.*)\")) / sum by (route) (label_replace(rate(traces_spanmetrics_calls_total{service=\"bff\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"HTTP .*\", span_name!~\"HTTP GET /(readyz|livez)\"}[$__rate_interval]), \"route\", \"$1\", \"span_name\", \"(.*)\"))",
