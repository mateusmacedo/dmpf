{
  "uid": "dmpf-reference",
  "title": "DMPF — topologia de referência (BFF, orders, reservations)",
  "description": "As três séries de serviço do kernel (MET-08, MET-09, MET-10) dos três serviços da topologia — dmpf-reference-bff, dmpf-reference-orders e dmpf-reference-reservations, filtrados por $service —, o fluxo assíncrono e os logs correlacionados por trace_id.",
  "tags": ["dmpf", "kernel"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(dmpf_service_requests_total, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "operation",
        "label": "Operação",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(dmpf_service_requests_total{service_name=~\"$service\"}, operation)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Serviço",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "Requisições por operação e desfecho",
      "description": "MET-08. Toda operação conta como requisição, inclusive a recusada pelo domínio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (operation, outcome_category) (rate(dmpf_service_requests_total{service_name=~\"$service\", operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} · {{outcome_category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Erros por categoria",
      "description": "MET-09. Só a falha técnica conta como erro: a recusa de negócio é o ramo refutante da UPR (DEC-04).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (error_category) (rate(dmpf_service_errors_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{error_category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Latência por operação (p50, p95, p99)",
      "description": "MET-10, em segundos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(dmpf_service_request_duration_seconds_bucket{service_name=~\"$service\", operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(dmpf_service_request_duration_seconds_bucket{service_name=~\"$service\", operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(dmpf_service_request_duration_seconds_bucket{service_name=~\"$service\", operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p99 {{operation}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Taxa de erro",
      "description": "Erros técnicos sobre requisições, na janela do painel.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(dmpf_service_errors_total{service_name=~\"$service\"}[$__rate_interval])) / clamp_min(sum(rate(dmpf_service_requests_total{service_name=~\"$service\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "taxa de erro"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Fluxo assíncrono e resiliência",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Recusas de admissão por rota",
      "description": "MET-12: a borda recusou antes de ler o corpo (RES-17).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(dmpf_service_admission_rejections_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Retentativas por dependência",
      "description": "Retry por conjunção (FND-08): só o erro declarado transiente é retentado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (dependency) (rate(dmpf_dependency_retries_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Chamadas por span (Tempo)",
      "description": "Séries que o metrics_generator do Tempo deriva dos spans e escreve no Prometheus por remote write. O mapa de serviços fica em Explore → Tempo → Service Graph, que precisa de spans de cliente e de servidor pareados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Traces e logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "table",
      "id": 8,
      "title": "Traces recentes",
      "description": "Clique num trace para abrir a linha do tempo; dela se chega aos logs pelo trace_id.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceqlSearch",
          "limit": 20,
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=~",
              "scope": "resource",
              "value": ["$service"],
              "valueType": "string"
            }
          ]
        }
      ]
    },
    {
      "type": "logs",
      "id": 9,
      "title": "Logs do serviço",
      "description": "O handler do kernel escreve JSON com service, trace_id e a redação de LOG-01.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 27 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\"$service\"} | json | line_format \"{{.level}}\\t{{.msg}}\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
