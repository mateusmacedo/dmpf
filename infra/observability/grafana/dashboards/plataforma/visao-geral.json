{
  "uid": "dmpf-overview",
  "title": "DMPF · Visão geral",
  "description": "Primeira tela da plataforma: o que está de pé, se a borda e os contextos respondem, se o fluxo assíncrono anda e o que satura. Cada série por serviço leva ao dashboard do serviço.",
  "tags": ["dmpf", "plataforma"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards DMPF",
      "type": "dashboards",
      "tags": ["dmpf"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Saúde",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Processos por serviço e papel",
      "description": "target_info por service.name e dmpf.process.role (RF-E3): um por processo que exporta OTLP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (service_name, dmpf_process_role) (target_info{service_name!=\"\"})",
          "legendFormat": "{{service_name}} {{dmpf_process_role}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Segundos desde a última exportação OTLP",
      "description": "Quem só empurra OTLP não tem `up`. A exportação é a cada 60 s: acima de 120 s, o processo parou ou o Collector está fora.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (service_name, instance) (timestamp(target_info{service_name!=\"\"}))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Alvos de scrape e floci",
      "description": "`up` de cada job de scrape e o probe do blackbox no floci, que não expõe métricas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fora",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "no ar",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (job) (up)",
          "legendFormat": "{{job}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance) (probe_success)",
          "legendFormat": "floci",
          "refId": "B"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "row",
