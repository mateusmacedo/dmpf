    {
      "type": "timeseries",
      "title": "Vazão da borda",
      "description": "MET-09: _count de http.server.request.duration do otelhttp do BFF; as rotas de saúde não entram (RF-B2).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"bff\"}[$__rate_interval]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "interval": "2m",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Respostas 5xx e 429 da borda",
      "description": "Fração das requisições da janela: 5xx é falha, 429 é recusa de admissão. Conta a série que nasce na janela, porque o primeiro 504 de uma rota cria a série. O 404 do polling de convergência fica de fora.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum ((increase(http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=~\"5..\"}[$__rate_interval]) or http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=~\"5..\"} * 0) + ((http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=~\"5..\"} unless http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=~\"5..\"} offset $__rate_interval) or http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=~\"5..\"} * 0)) / clamp_min(sum ((increase(http_server_request_duration_seconds_count{service_name=\"bff\"}[$__rate_interval]) or http_server_request_duration_seconds_count{service_name=\"bff\"} * 0) + ((http_server_request_duration_seconds_count{service_name=\"bff\"} unless http_server_request_duration_seconds_count{service_name=\"bff\"} offset $__rate_interval) or http_server_request_duration_seconds_count{service_name=\"bff\"} * 0)), 1)",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum ((increase(http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=\"429\"}[$__rate_interval]) or http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=\"429\"} * 0) + ((http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=\"429\"} unless http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=\"429\"} offset $__rate_interval) or http_server_request_duration_seconds_count{service_name=\"bff\", http_response_status_code=\"429\"} * 0)) / clamp_min(sum ((increase(http_server_request_duration_seconds_count{service_name=\"bff\"}[$__rate_interval]) or http_server_request_duration_seconds_count{service_name=\"bff\"} * 0) + ((http_server_request_duration_seconds_count{service_name=\"bff\"} unless http_server_request_duration_seconds_count{service_name=\"bff\"} offset $__rate_interval) or http_server_request_duration_seconds_count{service_name=\"bff\"} * 0)), 1)",
          "legendFormat": "429",
          "refId": "B"
        }
      ],
      "interval": "2m",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latência da borda (p95)",
      "description": "MET-08: percentil 95 de http.server.request.duration do BFF, em segundos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
