# Copie para infra/local/.env (ignorado pelo git) e ajuste. Todo valor tem
# default no compose; este arquivo só documenta o que pode ser sobrescrito.

# Postgres (profile postgres)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis (profile redis)
REDIS_PORT=6379

# Redpanda (profile redpanda): porta publicada no host; dentro do projeto os
# containers usam redpanda:29092
REDPANDA_PORT=9092

# floci — SQS e SNS (profile floci)
FLOCI_PORT=4566

# Observabilidade (profile observability): Collector, Prometheus, Loki, Tempo,
# Alloy e Grafana. A interface do Grafana fica em http://localhost:3000
OTLP_GRPC_PORT=4317
OTELCOL_METRICS_PORT=8888
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
ALLOY_PORT=12345
GRAFANA_PORT=3000

# Exporters (profile exporters): endpoints /metrics dos recursos sistêmicos.
# Publicados no host para inspeção direta; o Prometheus os raspa pela rede
# interna. cAdvisor usa 8081 no host porque 8080 é do papel api.
REDPANDA_ADMIN_PORT=9644
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
BLACKBOX_PORT=9115
CADVISOR_PORT=8081

# Grafana: o anônimo edita painéis; a administração do servidor pede login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Ferramentas de desenvolvimento: Swagger UI da api e Console do Redpanda
SWAGGER_PORT=8082
CONSOLE_PORT=8083

# dmpf-reference (profile dmpf)
DMPF_REFERENCE_IMAGE=dmpf-reference:local
DMPF_HTTP_PORT=8080
DMPF_KAFKA_TOPIC=orders.events
DMPF_KAFKA_DLQ=orders.events.dlq
DMPF_KAFKA_GROUP=reservations
DMPF_KAFKA_RESERVATIONS_TOPIC=reservations.events
DMPF_KAFKA_RESERVATIONS_DLQ=reservations.events.dlq
DMPF_SERVICE_VERSION=local
