# Copie para infra/local/.env (ignorado pelo git) e ajuste. Todo valor tem
# default no compose; este arquivo só documenta o que pode ser sobrescrito.

# Postgres (profile postgres): usuário administrativo do servidor. Cada app usa
# banco e role com o próprio nome, criados no postgres-init (profile dmpf)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis (profile redis)
REDIS_PORT=6379

# Redpanda (profile redpanda): porta publicada no host; dentro do projeto os
# containers usam redpanda:29092
REDPANDA_PORT=9092

# floci — SQS e SNS (profile floci)
FLOCI_PORT=4566

# Observabilidade (profile observability): Collector, Prometheus, Loki, Tempo,
# Alloy e Grafana. A interface do Grafana fica em http://localhost:3000
OTLP_GRPC_PORT=4317
OTELCOL_METRICS_PORT=8888
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
ALLOY_PORT=12345
GRAFANA_PORT=3000

# Exporters (profile exporters): endpoints /metrics dos recursos sistêmicos.
# Publicados no host para inspeção direta; o Prometheus os raspa pela rede
# interna. cAdvisor usa 8081 no host porque 8080 é do BFF.
REDPANDA_ADMIN_PORT=9644
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
BLACKBOX_PORT=9115
CADVISOR_PORT=8081

# Grafana sem acesso anônimo: este login abre o Explore, a edição de painéis e a administração do servidor
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Ferramentas de desenvolvimento: Swagger UI do BFF e Console do Redpanda
SWAGGER_PORT=8082
CONSOLE_PORT=8083

# Recurso OTel comum às apps; cada processo acrescenta a instância e o papel
OTEL_RESOURCE_ATTRIBUTES=service.version=local,deployment.environment.name=local

# Apps da topologia de referência (profile dmpf): imagem, senha de banco e de
# Kafka, tópicos e ajustes de cada app. Gerado por tools/dmpf-conformance/cmd/infrasync a partir de apps/backend/*/deploy/infra.json; não edite.
BFF_IMAGE=bff:local
BOOKINGS_IMAGE=bookings:local
ORDERS_IMAGE=orders:local
RESERVATIONS_IMAGE=reservations:local
BOOKINGS_PG_PASSWORD=bookings-local
ORDERS_PG_PASSWORD=orders-local
RESERVATIONS_PG_PASSWORD=reservations-local
KAFKA_BOOKINGS_PASSWORD=bookings-local
KAFKA_BOOKINGS_TOPIC=bookings.events
KAFKA_BOOKINGS_DLQ=bookings.events.dlq
KAFKA_ORDERS_PASSWORD=orders-local
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_ORDERS_DLQ=orders.events.dlq
KAFKA_RESERVATIONS_PASSWORD=reservations-local
KAFKA_RESERVATIONS_TOPIC=reservations.events
KAFKA_RESERVATIONS_DLQ=reservations.events.dlq
KAFKA_GROUP=reservations
HTTP_PORT=8080
ITEM_LIMIT=10
