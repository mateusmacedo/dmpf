{
  "name": "bookings-contract",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "apps/backend/bookings/contract",
  "tags": ["type:lib", "scope:backend", "stack:go", "layer:contract"],
  "targets": {
    "tidy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash ../../../../tools/go-tidy.sh",
        "cwd": "{projectRoot}"
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go", "{workspaceRoot}/tools/buf.sh"],
      "options": {
        "command": "go test -race ./...",
        "cwd": "{projectRoot}"
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "buf-warmup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash tools/buf-gate.sh warmup apps/backend/bookings/contract --project bookings-contract"
      }
    },
    "buf-lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["buf-warmup"],
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/**/*"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh lint apps/backend/bookings/contract --project bookings-contract"
      }
    },
    "buf-pins": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/go.mod"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh pins apps/backend/bookings/contract --project bookings-contract"
      }
    },
    "buf-generate-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["buf-warmup"],
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/gen/**/*",
        "{projectRoot}/go.mod",
        "{projectRoot}/**/*"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh generate-check apps/backend/bookings/contract --project bookings-contract"
      }
    },
    "buf-breaking": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/tools/buf.sh",
        "{workspaceRoot}/tools/buf-gate.sh",
        "{projectRoot}/**/*"
      ],
      "options": {
        "command": "bash tools/buf-gate.sh breaking apps/backend/bookings/contract --project bookings-contract"
      }
    }
  }
}
