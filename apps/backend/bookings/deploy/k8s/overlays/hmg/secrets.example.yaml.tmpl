# Forma dos Secrets do bookings que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
apiVersion: v1
kind: Secret
metadata:
  name: bookings
type: Opaque
stringData:
  PG_DSN: postgres://bookings:REPLACE_ME@postgres.hmg.internal:5432/bookings?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # bookings.events e bookings.events.dlq (ADR-052).
  KAFKA_SASL_USERNAME: bookings
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: bookings-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
