# Processo do bookings no host, contra a infra local (`pnpm nx run bff:infra-up`).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/bookings/deploy/.env; set +a; pnpm nx run bookings:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam o PG_DSN administrativo do `.env` da raiz.
SERVICE=bookings
INSTANCE_ID=bookings-local
SERVICE_VERSION=local
PG_DSN=postgres://bookings:bookings-local@localhost:5432/bookings?sslmode=disable
MIGRATE=true
GRPC_ADDR=:9193
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=bookings
KAFKA_BOOKINGS_TOPIC=bookings.events
KAFKA_BOOKINGS_DLQ=bookings.events.dlq
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
TRACE_SAMPLE_RATE=1
LOG_LEVEL=debug
OTLP_LOGS=true
