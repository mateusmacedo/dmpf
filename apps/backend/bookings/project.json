{
  "name": "bookings",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/bookings",
  "tags": ["type:app", "scope:backend", "stack:go", "layer:apps"],
  "targets": {
    "nx-release-publish": {
      "executor": "nx:noop"
    },
    "tidy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash ../../../tools/go-tidy.sh",
        "cwd": "{projectRoot}"
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "options": {
        "command": "bash ../../../tools/test-env.sh go test -race -count=1 -p 1 -tags=integration ./...",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["testkit"],
          "target": "test-infra-up"
        }
      ]
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; exec go run ./cmd --role api",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["bff"],
          "target": "infra-up"
        },
        {
          "projects": ["bff"],
          "target": "infra-session"
        }
      ]
    },
    "serve-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; exec go run ./cmd --role relay",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": ["serve-api"]
    },
    "deploy-env": {},
    "docker:run-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker run --rm --name bookings-relay --network host --env-file deploy/.env apps-backend-bookings --role relay",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["docker:run"]
    },
    "test-distributed": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["testkit"],
          "target": "test-infra-up"
        },
        {
          "projects": ["postgres", "app"],
          "target": "test-race"
        },
        "test-race"
      ],
      "options": {
        "command": "bash ../../../tools/test-env.sh go test -race -count=1 -p 1 -tags=integration,distributed ./distkit/...",
        "cwd": "{projectRoot}"
      }
    }
  }
}
