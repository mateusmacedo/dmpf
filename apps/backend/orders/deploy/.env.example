# Processo do orders no host, contra a infra local (`pnpm nx run bff:infra-up`).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/orders/deploy/.env; set +a; pnpm nx run orders:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
SERVICE=orders
INSTANCE_ID=orders-local
SERVICE_VERSION=local
PG_DSN=postgres://orders:orders-local@localhost:5432/orders?sslmode=disable
MIGRATE=true
GRPC_ADDR=:9191
GRPC_INSECURE=true
ITEM_LIMIT=10
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=orders
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_ORDERS_DLQ=orders.events.dlq
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
TRACE_SAMPLE_RATE=1
LOG_LEVEL=debug
OTLP_LOGS=true
