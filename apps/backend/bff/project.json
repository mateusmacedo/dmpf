{
  "name": "bff",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/bff",
  "tags": ["type:app", "scope:backend", "stack:go", "layer:apps"],
  "targets": {
    "nx-release-publish": {
      "executor": "nx:noop"
    },
    "deploy-env": {},
    "docker:run": {
      "options": {
        "args": [
          "--rm",
          "--name bff",
          "--network host",
          "--env-file deploy/.env",
          "-e OPENAPI_ORDERS_PATH=/contracts/openapi/orders/v1/openapi.yaml",
          "-e OPENAPI_RESERVATIONS_PATH=/contracts/openapi/reservations/v1/openapi.yaml",
          "-e OPENAPI_BOOKINGS_PATH=/contracts/openapi/bookings/v1/openapi.yaml"
        ]
      },
      "dependsOn": [
        "deploy-env",
        "docker:build",
        "infra-up",
        {
          "projects": ["orders", "reservations", "bookings"],
          "target": "docker:run"
        },
        {
          "projects": ["orders", "reservations", "bookings"],
          "target": "docker:run-relay"
        },
        {
          "projects": ["reservations"],
          "target": "docker:run-consumer"
        }
      ]
    },
    "tidy": {
      "executor": "@mateusmacedo/dmpf-plugin:go-tidy",
      "cache": false
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "@mateusmacedo/dmpf-plugin:test-env",
      "cache": false,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration ./..."
      },
      "dependsOn": [
        {
          "projects": ["testkit"],
          "target": "test-infra-up"
        }
      ]
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; exec go run ./cmd",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": [
        "infra-session",
        {
          "projects": ["orders", "reservations", "bookings"],
          "target": "serve-api"
        },
        {
          "projects": ["orders", "reservations", "bookings"],
          "target": "serve-relay"
        },
        {
          "projects": ["reservations"],
          "target": "serve-consumer"
        }
      ]
    },
    "infra-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/infra-session.sh up",
        "cwd": "{workspaceRoot}"
      }
    },
    "observability-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infra/local/docker-compose.yml --profile postgres --profile observability --profile exporters up -d --wait",
        "cwd": "{workspaceRoot}"
      }
    },
    "infra-budget": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash tools/infra-budget.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "infra-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infra/local/docker-compose.yml --profile all --profile dmpf down",
        "cwd": "{workspaceRoot}"
      }
    },
    "k8s-render": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "kubectl kustomize infra/k8s/overlays/dev > /dev/null",
          "kubectl kustomize infra/k8s/overlays/hmg > /dev/null"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "infra-session": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["infra-up"],
      "options": {
        "command": "bash tools/infra-session.sh session",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
