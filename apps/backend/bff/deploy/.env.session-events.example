# Só do papel session-events (ADR-063): o client secret não chega à API, cujo
# AUTH_DEV_MOCK recusa um OIDC_ISSUER e cujo ADMIN_ADDR colide com o deste papel.
# O serve-session-events o carrega depois do deploy/.env, por isso estes valores vencem.
SESSION_EVENTS_ADDR=127.0.0.1:8091
ADMIN_ADDR=127.0.0.1:8092
OIDC_ISSUER=http://keycloak.localhost:8180/realms/dmpf
OIDC_SESSION_EVENTS_CLIENT_SECRET=dmpf-dev-session-events
