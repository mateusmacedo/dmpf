# BFF no host, contra os contextos rodando no host com os deploy/.env.example
# deles (gRPC sem TLS, portas 9191 a 9193). Copie para deploy/.env e carregue
# antes do target:
#   set -a; . apps/backend/bff/deploy/.env; set +a; pnpm nx run bff:serve
# Os caminhos de OpenAPI são relativos a apps/backend/bff, o cwd do serve.
SERVICE=bff
INSTANCE_ID=bff-local
SERVICE_VERSION=local
HTTP_ADDR=127.0.0.1:8080
ORDERS_GRPC_TARGET=dns:///127.0.0.1:9191
RESERVATIONS_GRPC_TARGET=dns:///127.0.0.1:9192
BOOKINGS_GRPC_TARGET=dns:///127.0.0.1:9193
GRPC_INSECURE=true
AUTH_DEV_MOCK=true
OPENAPI_ORDERS_PATH=../orders/contract/openapi/v1/openapi.yaml
OPENAPI_RESERVATIONS_PATH=../reservations/contract/openapi/v1/openapi.yaml
OPENAPI_BOOKINGS_PATH=../bookings/contract/openapi/v1/openapi.yaml
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
TRACE_SAMPLE_RATE=1
LOG_LEVEL=debug
OTLP_LOGS=true
