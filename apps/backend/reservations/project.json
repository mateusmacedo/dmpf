{
  "name": "reservations",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/reservations",
  "tags": ["type:app", "scope:backend", "stack:go", "layer:apps"],
  "targets": {
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration ./...",
        "cwd": "{projectRoot}"
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-distributed": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["postgres", "app"],
          "target": "test-race"
        },
        "test-race"
      ],
      "options": {
        "command": "go test -race -count=1 -p 1 -tags=integration,distributed ./distkit/...",
        "cwd": "{projectRoot}"
      }
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; exec go run ./cmd --role api",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true
    },
    "serve-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; until go run ./cmd --role relay; do echo \"reservations relay: nova tentativa em 2s (o serve-api aplica o schema)\" >&2; sleep 2; done",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": ["serve-api"]
    },
    "serve-consumer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; until go run ./cmd --role consumer; do echo \"reservations consumer: nova tentativa em 2s (o serve-api aplica o schema)\" >&2; sleep 2; done",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": ["serve-api"]
    }
  }
}
