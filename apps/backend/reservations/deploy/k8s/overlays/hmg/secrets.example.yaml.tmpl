# Forma dos Secrets do reservations que o overlay hmg espera no namespace. Não é resource
# do kustomization: em homologação eles vêm de um ExternalSecret/SealedSecret com
# os mesmos nomes (infra/k8s/overlays/hmg/secrets.example.yaml.tmpl).
apiVersion: v1
kind: Secret
metadata:
  name: reservations
type: Opaque
stringData:
  PG_DSN: postgres://reservations:REPLACE_ME@postgres.hmg.internal:5432/reservations?sslmode=require
  KAFKA_BROKERS: kafka-0.hmg.internal:9093,kafka-1.hmg.internal:9093
  # Principal SASL do contexto. ACL exigida: write e describe em
  # reservations.events, reservations.events.dlq e orders.events.dlq; read e
  # describe em orders.events e no grupo reservations (ADR-052).
  KAFKA_SASL_USERNAME: reservations
  KAFKA_SASL_PASSWORD: REPLACE_ME
---
# DSN da role migradora, dona do banco (ADR-063). Só o Deployment do api o
# referencia: o Secret reservations entra também no relay e no consumer.
apiVersion: v1
kind: Secret
metadata:
  name: reservations-migrator
type: Opaque
stringData:
  PG_MIGRATE_DSN: postgres://reservations_migrator:REPLACE_ME@postgres.hmg.internal:5432/reservations?sslmode=verify-full&channel_binding=require
---
apiVersion: v1
kind: Secret
metadata:
  name: reservations-grpc-tls
type: kubernetes.io/tls
stringData:
  tls.crt: REPLACE_ME
  tls.key: REPLACE_ME
