# Processo do reservations no host, contra a infra local (`pnpm nx run bff:infra-up`).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/reservations/deploy/.env; set +a; pnpm nx run reservations:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
SERVICE=reservations
INSTANCE_ID=reservations-local
SERVICE_VERSION=local
PG_DSN=postgres://reservations:reservations-local@localhost:5432/reservations?sslmode=disable
MIGRATE=true
GRPC_ADDR=127.0.0.1:9192
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=reservations
KAFKA_RESERVATIONS_TOPIC=reservations.events
KAFKA_RESERVATIONS_DLQ=reservations.events.dlq
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_ORDERS_DLQ=orders.events.dlq
ORDERS_SOURCE=urn:dmpf:reference-orders
OTLP_ENDPOINT=localhost:4317
OTLP_INSECURE=true
TRACE_SAMPLE_RATE=1
LOG_LEVEL=debug
OTLP_LOGS=true
