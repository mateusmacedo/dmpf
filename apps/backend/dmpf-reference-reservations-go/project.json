{
  "name": "dmpf-reference-reservations-go",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/dmpf-reference-reservations-go",
  "tags": ["type:app", "scope:backend", "stack:go", "layer:apps"],
  "targets": {
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go test -race -count=1 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DMPF_GRPC_INSECURE=true go run ./cmd/dmpf-reference-reservations --role api",
        "cwd": "{projectRoot}"
      }
    },
    "serve-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/dmpf-reference-reservations --role relay",
        "cwd": "{projectRoot}"
      }
    },
    "serve-consumer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/dmpf-reference-reservations --role consumer",
        "cwd": "{projectRoot}"
      }
    }
  }
}
