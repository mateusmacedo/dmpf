# Processo do <%- name %> no host, contra a infra local (`pnpm nx run bff:infra-up`).
# Copie para deploy/.env e carregue antes do target:
#   set -a; . apps/backend/<%- name %>/deploy/.env; set +a; pnpm nx run <%- name %>:serve-api
# Fica fora da raiz do projeto porque o Nx carrega o `.env` dela em todo target,
# inclusive nos testes, que usam a infra de testes do `.env.example` da raiz.
OTEL_SERVICE_NAME=<%- name %>
OTEL_RESOURCE_ATTRIBUTES=service.version=local,service.instance.id=<%- name %>-local,deployment.environment.name=local
PG_DSN=postgres://<%- name %>:<%- name %>-local@localhost:5432/<%- name %>?sslmode=disable
MIGRATE=true
GRPC_ADDR=127.0.0.1:<%- grpcPort %>
GRPC_INSECURE=true
KAFKA_BROKERS=localhost:9092
KAFKA_INSECURE=true
KAFKA_GROUP=<%- name %>
KAFKA_<%- envName %>_TOPIC=<%- name %>.events
KAFKA_<%- envName %>_DLQ=<%- name %>.events.dlq
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext
OTEL_GO_X_OBSERVABILITY=true
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BLRP_EXPORT_TIMEOUT=3000
LOG_LEVEL=debug
