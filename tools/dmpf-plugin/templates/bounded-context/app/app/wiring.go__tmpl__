package app

import (
	"context"
	"fmt"
	"reflect"

	"github.com/jackc/pgx/v5/pgxpool"
	"google.golang.org/grpc"

	"<%- modulePath %>/app/rpc"
	"<%- modulePath %>/application"
	"<%- modulePath %>/provider"
	"github.com/mateusmacedo/dmpf/libs/backend/go/app/serve"
	"github.com/mateusmacedo/dmpf/libs/backend/go/observability/boot"
	"github.com/mateusmacedo/dmpf/libs/backend/go/observability/otelboot"
)

func Run(ctx context.Context, cfg Config) error {
	return boot.Boot(ctx, TelemetryOf(cfg), func(ctx context.Context, rt *otelboot.Runtime) error {
		return RunWith(ctx, cfg, rt)
	})
}

// RunWith is the delegate a caller that already owns the telemetry enters by,
// which is what the harnesses use.
func RunWith(ctx context.Context, cfg Config, rt *otelboot.Runtime) error {
	switch cfg.Role {
	case RoleAPI:
		return serve.ServeAPI(ctx, rt, apiRole(cfg), api())
	case RoleRelay:
		ch, err := <%- pascalName %>Channel(cfg)
		if err != nil {
			return err
		}
		return serve.RunRelay(ctx, rt, relayRole(cfg), serve.Relay{Component: "<%- name %>", Channel: ch, Scope: reflect.TypeFor[Config]().PkgPath()})
	default:
		return fmt.Errorf("%w: %q", ErrUnknownRole, cfg.Role)
	}
}

func api() serve.API {
	return serve.API{
		Desc: &rpc.ServiceDesc, Commands: rpc.Commands(), Schema: provider.Schema, CommandConsumer: application.CommandConsumer,
		Register: func(server *grpc.Server, _ *pgxpool.Pool) error {
			server.RegisterService(&rpc.ServiceDesc, rpc.Server{})
			return nil
		},
	}
}
