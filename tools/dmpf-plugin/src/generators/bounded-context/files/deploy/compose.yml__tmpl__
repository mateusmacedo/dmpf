# Processos do <%- name %> na topologia local (ADR-044): api gRPC, que aplica o
# schema (MIGRATE=true), e relay da própria outbox.
x-image: &image
  build:
    context: ../../../..
    dockerfile: apps/backend/<%- name %>/Dockerfile
  image: ${<%- envName %>_IMAGE:-<%- name %>:local}

x-env: &env
  SERVICE: <%- name %>
  PG_DSN: postgres://<%- name %>:${<%- envName %>_PG_PASSWORD:-<%- name %>-local}@postgres:5432/<%- name %>?sslmode=disable

services:
  dmpf-<%- name %>-api:
    <<: *image
    extends:
      file: ../../../../infra/local/compose/app-base.yml
      service: dmpf-grpc-api
    environment:
      <<: *env
      INSTANCE_ID: <%- name %>-api
      GRPC_TLS_CERT_FILE: /pki/dmpf-<%- name %>-api.crt
      GRPC_TLS_KEY_FILE: /pki/dmpf-<%- name %>-api.key
    depends_on:
      pki-init:
        condition: service_completed_successfully
      postgres-init:
        condition: service_completed_successfully
      otel-collector:
        condition: service_started

  dmpf-<%- name %>-relay:
    <<: *image
    extends:
      file: ../../../../infra/local/compose/app-base.yml
      service: dmpf-kafka-worker
    command: ['--role', 'relay']
    environment:
      <<: *env
      INSTANCE_ID: <%- name %>-relay
      KAFKA_SASL_USERNAME: <%- name %>
      KAFKA_SASL_PASSWORD: ${KAFKA_<%- envName %>_PASSWORD:-<%- name %>-local}
      KAFKA_GROUP: <%- name %>
      KAFKA_<%- envName %>_TOPIC: ${KAFKA_<%- envName %>_TOPIC:-<%- name %>.events}
      KAFKA_<%- envName %>_DLQ: ${KAFKA_<%- envName %>_DLQ:-<%- name %>.events.dlq}
    depends_on:
      redpanda-init:
        condition: service_completed_successfully
      dmpf-<%- name %>-api:
        condition: service_started
