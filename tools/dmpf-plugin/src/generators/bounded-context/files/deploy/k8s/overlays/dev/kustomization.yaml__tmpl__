apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../base

images:
  - name: ghcr.io/mateusmacedo/<%- name %>
    newTag: dev

secretGenerator:
  - name: <%- name %>
    literals:
      - PG_DSN=postgres://<%- name %>:<%- name %>-dev@postgres-0.postgres:5432/<%- name %>?sslmode=disable
      - KAFKA_BROKERS=redpanda-0.redpanda:9092
    options:
      disableNameSuffixHash: true

patches:
  - path: configmap-<%- name %>-patch.yaml
  - path: deployment-<%- name %>-api-patch.yaml
