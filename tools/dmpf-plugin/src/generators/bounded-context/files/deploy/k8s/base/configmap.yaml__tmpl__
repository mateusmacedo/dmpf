# Valores não sensíveis dos dois papéis; cada papel só lê o que lhe cabe.
# Os opt-outs de TLS nascem desligados e o transporte gRPC não tem default:
# o overlay declara o opt-out de desenvolvimento ou os arquivos do certificado.
apiVersion: v1
kind: ConfigMap
metadata:
  name: <%- name %>
data:
  SERVICE: <%- name %>
  GRPC_ADDR: ':9090'
  KAFKA_<%- envName %>_TOPIC: <%- name %>.events
  KAFKA_<%- envName %>_DLQ: <%- name %>.events.dlq
  KAFKA_GROUP: <%- name %>
  KAFKA_INSECURE: 'false'
  OTLP_ENDPOINT: otel-collector:4317
  OTLP_INSECURE: 'false'
