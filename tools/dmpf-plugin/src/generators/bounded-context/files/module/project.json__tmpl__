{
  "name": <%- projectNameJson %>,
  "$schema": <%- nxSchemaJson %>,
  "projectType": "application",
  "sourceRoot": <%- sourceRootJson %>,
  "tags": ["type:app", "scope:backend", "stack:go", <%- layerTagJson %>],
  "targets": {
    "tidy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": <%- tidyCommandJson %>,
        "cwd": "{projectRoot}"
      }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "saida=\"$(gofmt -l . 2>&1)\"; status=$?; [ $status -eq 0 ] || { printf '%s\\n' \"$saida\" >&2; exit $status; }; [ -z \"$saida\" ] || { printf '%s\\n' \"$saida\" >&2; exit 1; }",
        "cwd": "{projectRoot}"
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["go", "^go"],
      "options": {
        "command": "go vet ./...",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", "^go"],
      "options": {
        "command": "go build ./...",
        "cwd": "{projectRoot}"
      }
    },
    "test-race": {
      "executor": "nx:run-commands",
      "cache": <%- testRaceCacheJson %>,
      "inputs": ["go", "^go"],
      "options": {
        "command": <%- testRaceCommandJson %>,
        "cwd": "{projectRoot}"
      }<% if (testRaceCacheJson === 'false') { %>,
      "dependsOn": [
        {
          "projects": ["testkit"],
          "target": "test-infra-up"
        }
      ]<% } %>
    },
    "govulncheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...",
        "cwd": "{projectRoot}"
      }
    }<% if (hasApp) { %>,
    "nx-release-publish": {
      "executor": "nx:noop"
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a; [ ! -f deploy/.env ] || . deploy/.env; set +a; exec go run ./cmd --role api",
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["bff"],
          "target": "infra-up"
        },
        {
          "projects": ["bff"],
          "target": "infra-session"
        }
      ]
    },
    "serve-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": <%- serveRelayCommandJson %>,
        "cwd": "{projectRoot}",
        "envFile": "{projectRoot}/deploy/.env.example"
      },
      "continuous": true,
      "dependsOn": ["serve-api"]
    },
    "docker:run-relay": {
      "executor": "nx:run-commands",
      "options": {
        "command": <%- dockerRunRelayCommandJson %>,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["docker:run"]
    },
    "test-distributed": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["go", "^go"],
      "dependsOn": [
        {
          "projects": ["testkit"],
          "target": "test-infra-up"
        },
        {
          "projects": ["postgres", "app"],
          "target": "test-race"
        },
        "test-race"
      ],
      "options": {
        "command": <%- testDistributedCommandJson %>,
        "cwd": "{projectRoot}"
      }
    }<% } %>
  }
}
