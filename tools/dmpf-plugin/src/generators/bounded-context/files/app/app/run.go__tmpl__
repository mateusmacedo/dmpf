package app

import (
	"context"
	"errors"
	"fmt"
	"io"
)

// Role selects which process the binary becomes (BLK-02: the relay never
// shares a process with the request path).
type Role string

const (
	RoleAPI   Role = "api"
	RoleRelay Role = "relay"
)

// Roles lists the accepted values of --role.
var Roles = []Role{RoleAPI, RoleRelay}

var ErrUnknownRole = errors.New("<%- name %>: unknown role")

// Config is every operational value the roles need, resolved once at startup
// from the environment. Add the variables of this context as it grows: the
// configuration enters only this way, and a missing one refuses the start.
type Config struct {
	Role Role
}

// FromEnv reads the configuration through lookup so a test hands it a map
// instead of touching the process environment.
func FromEnv(role Role, lookup func(string) string) (Config, error) {
	cfg := Config{Role: role}
	if cfg.Role != RoleAPI && cfg.Role != RoleRelay {
		return Config{}, fmt.Errorf("%w: %q (want api|relay)", ErrUnknownRole, cfg.Role)
	}
	return cfg, nil
}

// Run is the composition root of the process: it is where the concrete
// providers of this context are instantiated (ADR-015), and the only place
// that knows which realization each port gets.
//
// The generated body composes nothing. It says so, then waits for the signal
// the orchestrator sends, so the process behaves like the service it will
// become instead of exiting as if it had done the work.
func Run(ctx context.Context, cfg Config, out io.Writer) error {
	_, _ = fmt.Fprintf(out, "<%- name %>: role %s has no composition root yet\n", cfg.Role)
	<-ctx.Done()
	return nil
}
