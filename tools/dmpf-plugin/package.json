{
  "name": "@mateusmacedo/dmpf-plugin",
  "version": "1.0.0-rc.2",
  "description": "Plugin Nx do DMPF: init, bounded-context, executors e migrations para consumir o kernel por versão",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusmacedo/dmpf.git",
    "directory": "tools/dmpf-plugin"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@mateusmacedo:registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared",
      "stack:node"
    ]
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "@nx/devkit": "^23.0.0"
  },
  "devDependencies": {
    "@nx/devkit": "catalog:"
  },
  "generators": "./generators.json",
  "executors": "./executors.json",
  "nx-migrations": {
    "migrations": "./migrations.json"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "executors.json",
    "migrations.json",
    "versions.json",
    "templates",
    "scripts",
    "src/**/schema.json"
  ]
}
