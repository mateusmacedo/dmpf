# {{$.GeneratedBy}}
{{- if .WithMigrator}}
# Idempotente, então reaplicar o overlay não falha; os `api` reiniciam até o
# banco existir. Com database.migrator (ADR-063), o banco pertence a
# <app>_migrator, e a role <app> não tem posse.
{{- else}}
# Cria banco e role de cada app no Postgres do overlay, com o banco pertencendo
# ao role. Idempotente: só cria o que falta, então reaplicar o overlay não
# falha; os `api` reiniciam até o banco existir e aplicam o schema na partida
# (MIGRATE).
{{- end}}
apiVersion: batch/v1
kind: Job
metadata:
  name: databases
spec:
  backoffLimit: 10
{{- if .WithMigrator}}
  ttlSecondsAfterFinished: 600
{{- end}}
  template:
    spec:
{{- if .WithMigrator}}
      automountServiceAccountToken: false
{{- end}}
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 70
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: create-databases
          image: postgres:16-alpine
          command: ['sh', '-c']
          args:
            - >-
              set -e; until pg_isready; do sleep 2; done
{{- if or .WithoutMigrator (not .WithMigrator)}};
              for pair in{{range .WithoutMigrator}} {{.App}}:${{.Database.PasswordEnv}}{{end}}; do
              app=${pair%%:*}; pass=${pair#*:};
              if ! psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$app'" | grep -q 1; then
              psql -c "CREATE ROLE \"$app\" LOGIN"; fi;
              psql -c "ALTER ROLE \"$app\" PASSWORD '$pass'";
              if ! psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$app'" | grep -q 1; then
              psql -c "CREATE DATABASE \"$app\" OWNER \"$app\""; fi; done
{{- end}}
{{- range .WithMigrator}};
              if ! psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '{{.App}}_migrator'" | grep -q 1; then
              psql -c "CREATE ROLE \"{{.App}}_migrator\" LOGIN"; fi;
              printf '%s\n' '\getenv pass {{.Database.Migrator.PasswordEnv}}' 'SET log_min_error_statement = panic;' 'SET log_statement = none;'
              "ALTER ROLE :\"role\" PASSWORD :'pass' LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;" | psql -v ON_ERROR_STOP=1 -v role={{.App}}_migrator;
              if ! psql -tAc "SELECT 1 FROM pg_database WHERE datname = '{{.App}}'" | grep -q 1; then
              psql -c "CREATE DATABASE \"{{.App}}\" OWNER \"{{.App}}_migrator\""; fi;
              if ! psql -tAc "SELECT 1 FROM pg_database WHERE datname = '{{.App}}' AND pg_get_userbyid(datdba) = '{{.App}}_migrator'" | grep -q 1; then
              psql -c "ALTER DATABASE \"{{.App}}\" OWNER TO \"{{.App}}_migrator\""; fi;
              psql -d "{{.App}}" -c "GRANT CREATE ON SCHEMA public TO \"{{.App}}_migrator\"";
              if ! psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '{{.App}}'" | grep -q 1; then
              psql -c "CREATE ROLE \"{{.App}}\" LOGIN"; fi;
              printf '%s\n' '\getenv pass {{.Database.PasswordEnv}}' 'SET log_min_error_statement = panic;' 'SET log_statement = none;'
              "ALTER ROLE :\"role\" PASSWORD :'pass' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;" | psql -v ON_ERROR_STOP=1 -v role={{.App}};
              psql -c "GRANT CONNECT ON DATABASE \"{{.App}}\" TO \"{{.App}}\"";
              psql -c "REVOKE CONNECT ON DATABASE \"{{.App}}\" FROM PUBLIC";
              psql -c "REVOKE TEMPORARY ON DATABASE \"{{.App}}\" FROM PUBLIC";
              psql -d "{{.App}}" -c "REVOKE CREATE ON SCHEMA public FROM PUBLIC";
              psql -d "{{.App}}" -c "REVOKE CREATE ON SCHEMA public FROM \"{{.App}}\"";
              psql -d "{{.App}}" -c "GRANT USAGE ON SCHEMA public TO \"{{.App}}\""
{{- end}}
          env:
            - name: PGHOST
              value: postgres-0.postgres
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: POSTGRES_USER
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: POSTGRES_PASSWORD
            - name: PGDATABASE
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: POSTGRES_DB
{{- range $m := .WithDatabase}}
            - name: {{.Database.PasswordEnv}}
              valueFrom:
                secretKeyRef:
                  name: databases
                  key: {{.App}}{{with .Database.Migrator}}
            - name: {{.PasswordEnv}}
              valueFrom:
                secretKeyRef:
                  name: databases
                  key: {{$m.App}}_migrator{{end}}{{end}}
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
