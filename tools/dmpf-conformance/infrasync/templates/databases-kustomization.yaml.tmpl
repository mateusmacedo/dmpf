# {{$.GeneratedBy}}
# Banco e role de cada app no Postgres do overlay (ADR-053), com as senhas de
# desenvolvimento no Secret que o Job lê.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - job.yaml

secretGenerator:
  - name: databases
    literals:
{{- range $m := .WithDatabase}}
      - {{.App}}={{.Database.Dev}}{{with .Database.Migrator}}
      - {{$m.App}}_migrator={{.Dev}}{{end}}{{end}}
    options:
      disableNameSuffixHash: true
