# Plataforma de teste
PLATFORM_PORT=1

# Apps da topologia de referência (profile dmpf): imagem, senha de banco e de
# Kafka, tópicos e ajustes de cada app. Gerado por tools/dmpf-conformance/cmd/infrasync a partir de apps/backend/*/deploy/infra.json; não edite.
ALPHA_IMAGE=alpha:local
BETA_IMAGE=beta:local
EDGE_IMAGE=edge:local
ALPHA_PG_PASSWORD=alpha-local
BETA_PG_PASSWORD=beta-local
KAFKA_ALPHA_PASSWORD=alpha-local
KAFKA_ALPHA_TOPIC=alpha.events
KAFKA_ALPHA_DLQ=alpha.events.dlq
KAFKA_BETA_PASSWORD=beta-local
KAFKA_BETA_TOPIC=beta.events
KAFKA_GROUP=beta
ITEM_LIMIT=10
HTTP_PORT=8080
